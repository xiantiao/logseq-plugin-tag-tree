{
  "name": "logseq-plugin-tag-tree",
  "version": "1.0.2",
  "main": "dist/index.html",
  "author": "xiantiao",
  "description": "Tag Tree: hierarchical tags for Logseq with an inline a/b/#c syntax — tree panel, tag filtering (AND/OR/NOT), usage browser, rename/move/merge, and legacy #a/b/c migration.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.36",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/react-fontawesome": "^0.1.16",
    "@logseq/libs": "^0.0.15",
    "@radix-ui/colors": "^0.1.8",
    "@radix-ui/react-collapsible": "^0.1.5",
    "@radix-ui/react-toolbar": "^0.1.4",
    "@stitches/react": "^1.2.8",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@types/react": "^17.0.33",
    "@types/react-dom": "^17.0.10",
    "@vitejs/plugin-react": "^1.0.7",
    "typescript": "^4.5.4",
    "vite": "^2.7.2",
    "vite-tsconfig-paths": "^3.3.17"
  },
  "logseq": {
    "id": "logseq-plugin-tag-tree",
    "title": "Tag Tree",
    "icon": "logo.svg",
    "keybindings": [
      {
        "command": "open-tags-panel"
      }
    ]
  }
}